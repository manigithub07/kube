Deploy+ser

apiVersion: apps/v1
kind: Deployment
metadata:
  name: cdac-web
spec:
  replicas: 3
  selector:
    matchLabels:
      app: cdac-web
  template:
    metadata:
      labels:
        app: cdac-web
    spec:
      containers:
        - name: web
          image: cdac-web:v1
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: cdac-web
spec:
  type: NodePort
  selector:
    app: cdac-web
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30080
